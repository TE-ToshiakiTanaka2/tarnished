{
  "name": "pr-status-update",
  "version": "1.0.0",
  "description": "Automatically update linked issue status in GitHub Project when PR is opened",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && ncc build src/index.ts -o dist --license licenses.txt && find dist \\( -name '*.d.ts' -o -name '*.d.ts.map' -o -name '*.js.map' -o -name 'sourcemap-register.cjs' \\) -delete && find dist -type d -empty -delete",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": ["github", "actions", "project", "pull-request", "automation"],
  "author": "tarnished",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@octokit/graphql": "^7.0.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vercel/ncc": "^0.38.1",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
