# syntax=docker/dockerfile:1
FROM debian:trixie-slim

# -----------------------------------------------------------------------------
# Install contract (#325)
#   OS packages        this file (apt-get as root)
#   Language runtimes  mise.toml, installed by mise as the vscode user
#   AI CLIs / plugins  .devcontainer/scripts/setup_*.sh (post.sh)
# Everything above the SHELL line runs under /bin/sh (dash): keep it POSIX.
# Plugin OS-package blocks (TeX Live, PostgreSQL / MySQL clients) are inserted
# directly above the SHELL line by the plugin_dockerfile hooks.
# -----------------------------------------------------------------------------

# Base tools. build-essential gives Rust (linker), native Node addons, Python
# sdists and cgo a C toolchain; curl, gnupg and minisign verify the downloads
# below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    gnupg \
    jq \
    minisign \
    openssh-client \
    procps \
    ripgrep \
    rsync \
    sudo \
    unzip \
    vim \
    xz-utils \
    zstd \
    && rm -rf /var/lib/apt/lists/*

# GitHub CLI from the official apt repository. The keyring is only accepted when
# it carries the fingerprint below.
# Source: https://github.com/cli/cli/blob/trunk/docs/install_linux.md
ARG GH_KEYRING_FINGERPRINT=2C6106201985B60E6C7AC87323F3D4EA75716059
RUN set -eu; \
    export GNUPGHOME="$(mktemp -d)"; \
    install -d -m 755 /etc/apt/keyrings; \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /tmp/githubcli-archive-keyring.gpg; \
    gpg --show-keys --with-colons /tmp/githubcli-archive-keyring.gpg | grep -q "^fpr:::::::::${GH_KEYRING_FINGERPRINT}:"; \
    install -m 644 /tmp/githubcli-archive-keyring.gpg /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    rm -rf /tmp/githubcli-archive-keyring.gpg "$GNUPGHOME"; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh; \
    rm -rf /var/lib/apt/lists/*

# mise (https://mise.jdx.dev), pinned and signature-verified: minisign over
# SHASUMS256.txt, then sha256 of the binary. amd64 -> linux-x64, arm64 -> linux-arm64.
# Source of the public key: https://mise.jdx.dev/installing-mise.html
# (also minisign.pub in https://github.com/jdx/mise)
ARG MISE_VERSION=2026.10.25
ARG MISE_MINISIGN_PUBKEY=RWTC3g8W3z4RZK3V3qv7fa1QY4JEWyBtqIHW+85QlJpZc5yG+uNYNBSZ
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
        amd64) mise_arch=x64 ;; \
        arm64) mise_arch=arm64 ;; \
        *) echo "Unsupported architecture for mise: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/jdx/mise/releases/download/v${MISE_VERSION}"; \
    asset="mise-v${MISE_VERSION}-linux-${mise_arch}"; \
    workdir="$(mktemp -d)"; \
    cd "$workdir"; \
    curl -fsSL -o SHASUMS256.txt "${base}/SHASUMS256.txt" \
        -o SHASUMS256.txt.minisig "${base}/SHASUMS256.txt.minisig" \
        -o "$asset" "${base}/${asset}"; \
    minisign -Vm SHASUMS256.txt -P "${MISE_MINISIGN_PUBKEY}"; \
    grep " ./${asset}\$" SHASUMS256.txt | sha256sum -c -; \
    install -m 0755 "$asset" /usr/local/bin/mise; \
    cd /; \
    rm -rf "$workdir"

# Create non-root user 'vscode' for DevContainer compatibility
ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# >>> mise runtimes >>>
# Runtimes come from mise.toml. Shims on PATH serve non-interactive processes
# (bash -c, post.sh, editors); `mise activate` serves interactive shells.
# npm packages installed with `npm install -g` land in the active Node's own
# prefix under the mise data directory, which vscode owns (no sudo needed).
USER ${USERNAME}
ENV PATH="/home/${USERNAME}/.local/share/mise/shims:${PATH}" \
    MISE_TRUSTED_CONFIG_PATHS=/workspace
RUN echo 'eval "$(mise activate bash)"' >> "/home/${USERNAME}/.bashrc"
WORKDIR /workspace
COPY --chown=${USERNAME}:${USERNAME} mise.toml /workspace/mise.toml
# GITHUB_TOKEN (optional BuildKit secret) only raises the GitHub API rate limit
# for the install: docker build --secret id=github_token,env=GITHUB_TOKEN ...
RUN --mount=type=secret,id=github_token,env=GITHUB_TOKEN,required=false mise install
# <<< mise runtimes <<<

CMD ["sleep", "infinity"]
