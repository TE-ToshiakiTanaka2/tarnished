{
  "name": "{{PROJECT_NAME}}",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "{{PROJECT_NAME}}",
  "runServices": ["{{PROJECT_NAME}}"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "mhutchie.git-graph",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.exclude": {
          "**/.git": true,
          "**/.DS_Store": true,
          "**/Thumbs.db": true,
          "**/*.swp": true,
          "**/*.swo": true,
          "**/*~": true,
          "**/.hg": true,
          "**/.svn": true
        }
      }
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/scripts/post.sh",
  "postStartCommand": "bash .devcontainer/scripts/refresh-assets.sh || true"
}
