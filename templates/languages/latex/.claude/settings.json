{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*.tex)",
            "command": "f=\"$(jq -r '.tool_input.file_path')\" && { latexindent -w -s \"$f\" 2>/dev/null; rm -f \"$f.bak\" indent.log; }"
          },
          {
            "type": "command",
            "if": "Edit(*.tex)",
            "command": "f=\"$(jq -r '.tool_input.file_path')\" && { latexindent -w -s \"$f\" 2>/dev/null; rm -f \"$f.bak\" indent.log; }"
          }
        ]
      }
    ]
  }
}
