{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*.ts)",
            "command": "f=\"$(jq -r '.tool_input.file_path')\" && pnpm exec biome check --write \"$f\""
          },
          {
            "type": "command",
            "if": "Edit(*.ts)",
            "command": "f=\"$(jq -r '.tool_input.file_path')\" && pnpm exec biome check --write \"$f\""
          },
          {
            "type": "command",
            "if": "Write(*.tsx)",
            "command": "f=\"$(jq -r '.tool_input.file_path')\" && pnpm exec biome check --write \"$f\""
          },
          {
            "type": "command",
            "if": "Edit(*.tsx)",
            "command": "f=\"$(jq -r '.tool_input.file_path')\" && pnpm exec biome check --write \"$f\""
          }
        ]
      }
    ]
  }
}
