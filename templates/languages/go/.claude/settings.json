{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*.go)",
            "command": "f=\"$(jq -r '.tool_input.file_path')\" && gofmt -w \"$f\""
          },
          {
            "type": "command",
            "if": "Edit(*.go)",
            "command": "f=\"$(jq -r '.tool_input.file_path')\" && gofmt -w \"$f\""
          }
        ]
      }
    ]
  }
}
