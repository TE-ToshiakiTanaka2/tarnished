{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(*.go)",
        "hooks": [
          {
            "type": "command",
            "command": "gofmt -w \"$CLAUDE_FILE_PATH\" && go vet ./..."
          }
        ]
      },
      {
        "matcher": "Edit(*.go)",
        "hooks": [
          {
            "type": "command",
            "command": "gofmt -w \"$CLAUDE_FILE_PATH\" && go vet ./..."
          }
        ]
      }
    ]
  }
}
