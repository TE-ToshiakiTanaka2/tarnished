{
  "name": "rust",
  "version": "1.0.0",
  "description": "Rust development environment with rust-analyzer",
  "category": "languages",
  "author": "tarnished",
  "dependencies": {
    "features": ["git"],
    "plugins": []
  },
  "variables": {
    "RUST_VERSION": {
      "description": "Rust toolchain version",
      "type": "select",
      "default": "stable",
      "options": ["stable", "nightly", "1.75.0", "1.76.0", "1.77.0"]
    },
    "RUST_COMPONENTS": {
      "description": "Additional rustup components",
      "type": "multiselect",
      "default": ["clippy", "rustfmt"],
      "options": ["clippy", "rustfmt", "rust-src", "rust-analyzer", "llvm-tools-preview"]
    },
    "CARGO_TOOLS": {
      "description": "Cargo tools to install",
      "type": "multiselect",
      "default": ["cargo-watch", "cargo-edit"],
      "options": ["cargo-watch", "cargo-edit", "cargo-deny", "cargo-audit", "cargo-nextest", "cargo-llvm-cov"]
    }
  },
  "provides": {
    "features": [],
    "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml", "serayuzgur.crates"],
    "hooks": true,
    "dockerfile": true,
    "post_setup": true,
    "workflows": true
  }
}
