# =============================================================================
# Project Integration Workflow
# =============================================================================
# Automatically links new Issues to GitHub Projects using erd CLI.
#
# Prerequisites:
#   1. Create a GitHub Personal Access Token (classic) with these scopes:
#      - repo (Full control of private repositories)
#      - project (Full control of projects)
#   2. Add the token as a repository secret named PROJECT_TOKEN:
#      Settings > Secrets and variables > Actions > New repository secret
#   3. Create .github/project.yml with your project configuration:
#      ```yaml
#      default_project:
#        owner: "your-username-or-org"
#        number: 1  # Your project number
#      field_defaults:
#        Status: "Backlog"
#        Size: "M"
#        Priority: "P1"
#      ```
#
# For more information about erd: https://github.com/TE-ToshiakiTanaka2/tarnished
# =============================================================================

name: Project Integration

on:
  issues:
    types: [opened, reopened]

permissions:
  contents: read
  issues: write

env:
  CARGO_TERM_COLOR: always

jobs:
  add-to-project:
    name: Add Issue to Project
    runs-on: ubuntu-latest
    steps:
      - name: Checkout erd repository
        uses: actions/checkout@v4
        with:
          repository: TE-ToshiakiTanaka2/tarnished
          ref: develop

      - name: Setup Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Cache cargo registry
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target
          key: ${{ runner.os }}-cargo-erd-${{ hashFiles('**/Cargo.lock') }}
          restore-keys: |
            ${{ runner.os }}-cargo-erd-
            ${{ runner.os }}-cargo-

      - name: Build erd
        run: cargo build --release

      - name: Checkout target repository for config
        uses: actions/checkout@v4
        with:
          path: target-repo

      - name: Link issue to project
        id: link
        run: |
          ./target/release/erd issue link ${{ github.event.issue.number }} \
            --config target-repo/.github/project.yml \
            --verbose
        env:
          PROJECT_TOKEN: ${{ secrets.PROJECT_TOKEN }}
          ERD_REPO: ${{ github.repository }}
        continue-on-error: true

      - name: Comment on failure
        if: steps.link.outcome == 'failure'
        uses: actions/github-script@v7
        with:
          script: |
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              body: `⚠️ **Project Integration Failed**\n\nFailed to automatically link this issue to the project. This may be due to:\n- Missing \`PROJECT_TOKEN\` secret\n- Invalid project configuration in \`.github/project.yml\`\n- GitHub API errors\n\nPlease link the issue to the project manually or check the [workflow run](${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}) for details.`
            });

      - name: Fail job if link failed
        if: steps.link.outcome == 'failure'
        run: exit 1
