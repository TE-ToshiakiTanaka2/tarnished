{
  "model": "claude-fable-5",
  "permissions": {
    "allow": [
      "Bash(codex:*)"
    ],
    "deny": [
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(brew install:*)",
      "Bash(chmod 777:*)",
      "Bash(gh repo delete:*)",
      "Bash(git config --global:*)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/deny-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*.rs)",
            "command": "f=\"$(jq -r '.tool_input.file_path')\" && cargo fmt -- \"$f\" && cargo clippy --fix --allow-dirty --allow-staged -- -W clippy::all"
          },
          {
            "type": "command",
            "if": "Edit(*.rs)",
            "command": "f=\"$(jq -r '.tool_input.file_path')\" && cargo fmt -- \"$f\" && cargo clippy --fix --allow-dirty --allow-staged -- -W clippy::all"
          }
        ]
      }
    ]
  }
}
