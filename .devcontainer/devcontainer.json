{
  "name": "Tarnished",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "tarnished",
  "runServices": [
    "tarnished"
  ],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/scripts/post.sh",
  "postStartCommand": "bash .devcontainer/scripts/refresh-assets.sh || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "ms-azuretools.vscode-docker",
        "rust-lang.rust-analyzer",
        "serayuzgur.crates",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.exclude": {
          "**/target": true
        }
      }
    },
    "zed": {
      "extensions": [
        "dockerfile",
        "toml"
      ]
    }
  }
}
